{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/*.local.json)",
      "Read(//**/ft_userdata/secrets/**)",
      "Read(//**/ft_userdata/user_data/config.json)",
      "Read(//**/ft_userdata/**/*.sqlite*)",
      "Read(//**/ft_userdata/**/*.db)",
      "Read(//**/ft_userdata/**/logs/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune *)",
      "Bash(gh api *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue comment *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(docker *)",
      "Bash(rm *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "PowerShell(git commit *)",
      "PowerShell(git pull *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(git merge *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git stash *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch --delete *)",
      "PowerShell(git worktree remove *)",
      "PowerShell(git worktree prune *)",
      "PowerShell(gh api *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue edit *)",
      "PowerShell(gh issue close *)",
      "PowerShell(gh issue reopen *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun *)",
      "PowerShell(gh run cancel *)",
      "PowerShell(gh release *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(docker *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(Start-Service *)",
      "PowerShell(Stop-Service *)",
      "PowerShell(Restart-Service *)",
      "PowerShell(Remove-Service *)",
      "PowerShell(schtasks.exe *)",
      "PowerShell(sc.exe *)",
